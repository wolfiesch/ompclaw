{
  "name": "ompclaw",
  "version": "0.11.0",
  "description": "OmpClaw: authenticated remote access to one persistent OMP session",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wolfiesch/ompclaw.git"
  },
  "homepage": "https://github.com/wolfiesch/ompclaw#readme",
  "bugs": {
    "url": "https://github.com/wolfiesch/ompclaw/issues"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "bin": {
    "ompclaw": "src/rpc-cli.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "ompclaw",
    "gateway",
    "telegram",
    "websocket",
    "rpc",
    "coding-agent"
  ],
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/dev",
    "!src/transports/telegram/test-harness.ts",
    "!src/transports/telegram/bot-api-lock-worker.ts",
    "README.md",
    "config.example.json",
    "SECURITY.md",
    "docs",
    "CHANGELOG.md",
    "tsconfig.json",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:harness": "bun test src/gateway-telegram.test.ts src/transports/telegram/adapter.test.ts src/dev/telegram-canary.test.ts",
    "test:telegram:ui": "bun ./src/dev/telegram-ui-scenario.ts",
    "test:telegram:live": "bun ./src/dev/telegram-canary.ts",
    "test:remote": "bun ./src/dev/remote-check.ts",
    "lint": "biome lint . --no-errors-on-unmatched",
    "fmt": "biome format --write . --no-errors-on-unmatched",
    "fmt:check": "biome format . --no-errors-on-unmatched",
    "check": "bun run lint && bun run typecheck && bun run test",
    "ci": "bun run check && npm pack --dry-run",
    "ompclaw": "bun ./src/rpc-cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@oh-my-pi/pi-coding-agent": "^17.0.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "@types/bun": "^1.2.0"
  },
  "overrides": {
    "@opentelemetry/core": "2.8.0"
  },
  "dependencies": {
    "croner": "10.0.1",
    "marked": "18.0.11"
  }
}
