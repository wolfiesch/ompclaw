{
  "name": "omp-gateway",
  "version": "0.1.0",
  "description": "Authenticated OMP gateway for Telegram and WebSocket clients",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wolfiesch/omp-gateway.git"
  },
  "homepage": "https://github.com/wolfiesch/omp-gateway#readme",
  "bugs": {
    "url": "https://github.com/wolfiesch/omp-gateway/issues"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "bin": {
    "omp-gateway": "./src/rpc-cli.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "gateway",
    "telegram",
    "websocket",
    "rpc",
    "coding-agent"
  ],
  "files": [
    "src/index.ts",
    "src/gateway-app.ts",
    "src/gateway-config.ts",
    "src/gateway-core.ts",
    "src/gateway-store.ts",
    "src/gateway-tools.ts",
    "src/gateway-types.ts",
    "src/rpc-cli.ts",
    "src/rpc-client.ts",
    "src/rpc-config.ts",
    "src/rpc-protocol.ts",
    "src/rpc-profile.ts",
    "src/rpc-runtime.ts",
    "src/rpc-service.ts",
    "src/rpc-ui.ts",
    "src/transports/telegram/adapter.ts",
    "src/transports/websocket/adapter.ts",
    "src/transports/websocket/protocol.ts",
    "src/api.ts",
    "src/inbox.ts",
    "src/markdown.ts",
    "src/outbound.ts",
    "src/type-guards.ts",
    "README.md",
    "config.example.json",
    "SECURITY.md",
    "docs",
    "NOTICE",
    "CHANGELOG.md",
    "tsconfig.json",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run test",
    "gateway": "bun ./src/rpc-cli.ts"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^17.0.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "@types/bun": "^1.2.0"
  },
  "overrides": {
    "@opentelemetry/core": "2.8.0"
  }
}
