{
  "workspace": ".",
  "stateDir": "~/.omp/agent/ompclaw",
  "profile": "ompclaw",
  "omp": {
    "command": "omp",
    "configFiles": [],
    "args": [],
    "allowRpcBash": false,
    "inheritHarness": false,
    "autoRestart": true
  },
  "transports": {
    "telegram": {
      "enabled": true,
      "account": "default",
      "tokenEnv": "TELEGRAM_BOT_TOKEN"
    },
    "websocket": {
      "enabled": true,
      "hostname": "127.0.0.1",
      "port": 7788,
      "account": "local",
      "credentials": [
        {
          "tokenEnv": "OMPCLAW_WEBSOCKET_TOKEN",
          "subject": "local-client",
          "channel": "ompclaw"
        }
      ]
    }
  },
  "automation": {
    "enabled": false,
    "pollIntervalMs": 1000,
    "retryDelayMs": 15000,
    "maxAttempts": 3
  },
  "learning": {
    "enabled": false,
    "autoCapture": false,
    "minToolCalls": 5,
    "memoryModel": "online"
  }
}
